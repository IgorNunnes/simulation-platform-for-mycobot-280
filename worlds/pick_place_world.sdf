    <model name="realsense_camera">
      <static>true</static>
      <pose>0.16 0.0 1.18 0 1.12 3.14159</pose>
      <link name="camera_link">
        <sensor name="realsense_rgbd" type="rgbd_camera">
          <update_rate>20</update_rate>
          <always_on>true</always_on>
