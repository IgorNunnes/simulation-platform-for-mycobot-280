<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="mycobot_280_pick">
  <xacro:arg name="controllers_file" default="$(find mycobot_realsense_pick_sim)/config/ros2_controllers.yaml"/>
  <xacro:arg name="initial_positions_file" default="$(find mycobot_realsense_pick_sim)/config/initial_positions.yaml"/>
  <xacro:property name="initial_positions_file_path" value="$(arg initial_positions_file)"/>
  <xacro:property name="initial_positions" value="${xacro.load_yaml(initial_positions_file_path)['initial_positions']}"/>

  <xacro:include filename="$(find mycobot_realsense_pick_sim)/config/mycobot_280_m5_adaptive_gripper_sim.urdf.xacro"/>
  <xacro:mycobot_280_adaptive_gripper_sim_model/>

  <link name="world"/>
  <joint name="world_to_g_base" type="fixed">
    <parent link="world"/>
    <child link="g_base"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <gazebo reference="g_base">
    <material>Gazebo/Black</material>
  </gazebo>

  <ros2_control name="GazeboSimSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <joint name="joint2_to_joint1">
      <command_interface name="position">
        <param name="min">-2.9321</param>
        <param name="max">2.9321</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">${initial_positions['joint2_to_joint1']}</param>
      </state_interface>
    </joint>
    <joint name="joint3_to_joint2">
      <command_interface name="position">
        <param name="min">-2.4434</param>
        <param name="max">2.4434</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">${initial_positions['joint3_to_joint2']}</param>
      </state_interface>
    </joint>
    <joint name="joint4_to_joint3">
      <command_interface name="position">
        <param name="min">-2.6179</param>
        <param name="max">2.6179</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">${initial_positions['joint4_to_joint3']}</param>
      </state_interface>
    </joint>
    <joint name="joint5_to_joint4">
      <command_interface name="position">
        <param name="min">-2.6179</param>
        <param name="max">2.6179</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">${initial_positions['joint5_to_joint4']}</param>
      </state_interface>
    </joint>
    <joint name="joint6_to_joint5">
      <command_interface name="position">
        <param name="min">-2.7052</param>
        <param name="max">2.7925</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">${initial_positions['joint6_to_joint5']}</param>
      </state_interface>
    </joint>
    <joint name="joint6output_to_joint6">
      <command_interface name="position">
        <param name="min">-3.14159</param>
        <param name="max">3.14159</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">${initial_positions['joint6output_to_joint6']}</param>
      </state_interface>
    </joint>
    <joint name="gripper_controller">
      <command_interface name="position">
        <param name="min">-0.74</param>
        <param name="max">0.15</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">${initial_positions['gripper_controller']}</param>
      </state_interface>
    </joint>
  </ros2_control>

  <gazebo>
    <plugin filename="libgz_ros2_control-system.so" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(arg controllers_file)</parameters>
      <robot_param>robot_description</robot_param>
      <robot_param_node>robot_state_publisher</robot_param_node>
      <controller_manager_name>controller_manager</controller_manager_name>
    </plugin>
  </gazebo>
</robot>
