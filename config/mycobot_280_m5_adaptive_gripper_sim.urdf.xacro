    <xacro:sim_link_gazebo link_name="g_base"/>
    <xacro:sim_link_gazebo link_name="joint1"/>
    <xacro:sim_link_gazebo link_name="joint2"/>
    <xacro:sim_link_gazebo link_name="joint3"/>
    <xacro:sim_link_gazebo link_name="joint4"/>
    <xacro:sim_link_gazebo link_name="joint5"/>
    <xacro:sim_link_gazebo link_name="joint6"/>
    <xacro:sim_link_gazebo link_name="joint6_flange"/>
    <xacro:sim_link_gazebo link_name="gripper_base"/>
    <xacro:sim_link_gazebo link_name="gripper_left1"/>
    <xacro:sim_link_gazebo link_name="gripper_left2"/>
    <xacro:sim_link_gazebo link_name="gripper_left3"/>
    <xacro:sim_link_gazebo link_name="gripper_right1"/>
    <xacro:sim_link_gazebo link_name="gripper_right2"/>
    <xacro:sim_link_gazebo link_name="gripper_right3"/>
  </xacro:macro>
</robot>
