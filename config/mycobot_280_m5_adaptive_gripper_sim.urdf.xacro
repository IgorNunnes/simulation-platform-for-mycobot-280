<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="mycobot_280_pick">
  <xacro:property name="joint_effort" value="56.0"/>
  <xacro:property name="joint_velocity" value="2.792527"/>
  <xacro:property name="joint_damping" value="0.0"/>
  <xacro:property name="joint_friction" value="0.0"/>

  <xacro:macro name="simple_inertial" params="mass ixx iyy izz">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${mass}"/>
      <inertia ixx="${ixx}" ixy="0.0" ixz="0.0" iyy="${iyy}" iyz="0.0" izz="${izz}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="sim_link_gazebo" params="link_name">
    <gazebo reference="${link_name}">
      <self_collide>false</self_collide>
    </gazebo>
  </xacro:macro>

  <xacro:macro name="mycobot_280_adaptive_gripper_sim_model">
    <link name="g_base">
      <xacro:simple_inertial mass="0.80" ixx="0.0015" iyy="0.0015" izz="0.0015"/>
      <visual>
        <geometry>
          <mesh filename="package://mycobot_description/urdf/mycobot_280_m5/G_base.dae"/>
        </geometry>
        <origin xyz="0.0 0 -0.03" rpy="0 0 1.5708"/>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://mycobot_description/urdf/mycobot_280_m5/G_base.dae"/>
        </geometry>
        <origin xyz="0.0 0 -0.03" rpy="0 0 1.5708"/>
      </collision>
    </link>

    <link name="joint1">
      <xacro:simple_inertial mass="0.12" ixx="0.000148" iyy="0.000148" izz="0.000096"/>
      <visual>
        <geometry>
          <mesh filename="package://mycobot_description/urdf/mycobot_280_m5/joint1.dae"/>
        </geometry>
        <origin xyz="0.0 0 0" rpy="0 0 -1.5708"/>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://mycobot_description/urdf/mycobot_280_m5/joint1.dae"/>
        </geometry>
        <origin xyz="0.0 0 0" rpy="0 0 -1.5708"/>
      </collision>
    </link>

    <link name="joint2">
      <xacro:simple_inertial mass="0.19" ixx="0.000148" iyy="0.000148" izz="0.000096"/>
      <visual>
        <geometry>
          <mesh filename="package://mycobot_description/urdf/mycobot_280_m5/joint2.dae"/>
        </geometry>
        <origin xyz="0.0 0 -0.06096" rpy="0 0 -1.5708"/>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://mycobot_description/urdf/mycobot_280_m5/joint2.dae"/>
        </geometry>
        <origin xyz="0.0 0 -0.06096" rpy="0 0 -1.5708"/>
      </collision>
    </link>

    <link name="joint3">
      <xacro:simple_inertial mass="0.16" ixx="0.000148" iyy="0.000148" izz="0.000096"/>
      <visual>
        <geometry>
          <mesh filename="package://mycobot_description/urdf/mycobot_280_m5/joint3.dae"/>
        </geometry>
        <origin xyz="0.0 0 0.03256" rpy="0 -1.5708 0"/>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://mycobot_description/urdf/mycobot_280_m5/joint3.dae"/>
        </geometry>
        <origin xyz="0.0 0 0.03256" rpy="0 -1.5708 0"/>
      </collision>
    </link>

    <link name="joint4">
      <xacro:simple_inertial mass="0.124" ixx="0.000103" iyy="0.000103" izz="0.000096"/>
      <visual>
        <geometry>
          <mesh filename="package://mycobot_description/urdf/mycobot_280_m5/joint4.dae"/>
        </geometry>
        <origin xyz="0.0 0 0.03056" rpy="0 -1.5708 0"/>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://mycobot_description/urdf/mycobot_280_m5/joint4.dae"/>
        </geometry>
        <origin xyz="0.0 0 0.03056" rpy="0 -1.5708 0"/>
      </collision>
    </link>

    <link name="joint5">
      <xacro:simple_inertial mass="0.11" ixx="0.000103" iyy="0.000103" izz="0.000096"/>
      <visual>
        <geometry>
          <mesh filename="package://mycobot_description/urdf/mycobot_280_m5/joint5.dae"/>
        </geometry>
        <origin xyz="0.0 0 -0.03356" rpy="-1.5708 0 0"/>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://mycobot_description/urdf/mycobot_280_m5/joint5.dae"/>
        </geometry>
        <origin xyz="0.0 0 -0.03356" rpy="-1.5708 0 0"/>
      </collision>
    </link>

    <link name="joint6">
      <xacro:simple_inertial mass="0.0739" ixx="0.00006649" iyy="0.00006649" izz="0.000096"/>
      <visual>
        <geometry>
          <mesh filename="package://mycobot_description/urdf/mycobot_280_m5/joint6.dae"/>
        </geometry>
        <origin xyz="0 0.00 -0.038" rpy="0 0 0"/>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://mycobot_description/urdf/mycobot_280_m5/joint6.dae"/>
        </geometry>
        <origin xyz="0 0.00 -0.038" rpy="0 0 0"/>
      </collision>
    </link>

    <link name="joint6_flange">
      <xacro:simple_inertial mass="0.035" ixx="0.0000149" iyy="0.0000149" izz="0.0000196"/>
      <visual>
        <geometry>
          <mesh filename="package://mycobot_description/urdf/mycobot_280_m5/joint7.dae"/>
        </geometry>
        <origin xyz="0.0 0 -0.012" rpy="0 0 0"/>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://mycobot_description/urdf/mycobot_280_m5/joint7.dae"/>
        </geometry>
        <origin xyz="0.0 0 -0.012" rpy="0 0 0"/>
      </collision>
    </link>

    <joint name="g_base_to_joint1" type="fixed">
      <axis xyz="0 0 0"/>
      <limit effort="1000.0" lower="-3.14" upper="3.14159" velocity="0"/>
      <parent link="g_base"/>
      <child link="joint1"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <joint name="joint2_to_joint1" type="revolute">
      <axis xyz="0 0 1"/>
      <limit effort="${joint_effort}" lower="-2.9321" upper="2.9321" velocity="${joint_velocity}"/>
      <dynamics damping="${joint_damping}" friction="${joint_friction}"/>
      <parent link="joint1"/>
      <child link="joint2"/>
      <origin xyz="0 0 0.13156" rpy="0 0 0"/>
    </joint>

    <joint name="joint3_to_joint2" type="revolute">
      <axis xyz="0 0 1"/>
      <limit effort="${joint_effort}" lower="-2.4434" upper="2.4434" velocity="${joint_velocity}"/>
      <dynamics damping="${joint_damping}" friction="${joint_friction}"/>
      <parent link="joint2"/>
      <child link="joint3"/>
      <origin xyz="0 0 0" rpy="0 1.5708 -1.5708"/>
    </joint>

    <joint name="joint4_to_joint3" type="revolute">
      <axis xyz="0 0 1"/>
      <limit effort="${joint_effort}" lower="-2.6179" upper="2.6179" velocity="${joint_velocity}"/>
      <dynamics damping="${joint_damping}" friction="${joint_friction}"/>
      <parent link="joint3"/>
      <child link="joint4"/>
      <origin xyz="-0.1104 0 0" rpy="0 0 0"/>
    </joint>

    <joint name="joint5_to_joint4" type="revolute">
      <axis xyz="0 0 1"/>
      <limit effort="${joint_effort}" lower="-2.6179" upper="2.6179" velocity="${joint_velocity}"/>
      <dynamics damping="${joint_damping}" friction="${joint_friction}"/>
      <parent link="joint4"/>
      <child link="joint5"/>
      <origin xyz="-0.096 0 0.06462" rpy="0 0 -1.5708"/>
    </joint>

    <joint name="joint6_to_joint5" type="revolute">
      <axis xyz="0 0 1"/>
      <limit effort="${joint_effort}" lower="-2.7052" upper="2.7925" velocity="${joint_velocity}"/>
      <dynamics damping="${joint_damping}" friction="${joint_friction}"/>
      <parent link="joint5"/>
      <child link="joint6"/>
      <origin xyz="0 -0.07318 0" rpy="1.5708 -1.5708 0"/>
    </joint>

    <joint name="joint6output_to_joint6" type="revolute">
      <axis xyz="0 0 1"/>
      <limit effort="${joint_effort}" lower="-3.14159" upper="3.14159" velocity="${joint_velocity}"/>
      <dynamics damping="${joint_damping}" friction="${joint_friction}"/>
      <parent link="joint6"/>
      <child link="joint6_flange"/>
      <origin xyz="0 0.0456 0" rpy="-1.5708 0 0"/>
    </joint>

    <joint name="joint6output_to_gripper_base" type="fixed">
      <parent link="joint6_flange"/>
      <child link="gripper_base"/>
      <origin xyz="0 0 0.034" rpy="1.579 0 0"/>
    </joint>

    <link name="gripper_base">
      <xacro:simple_inertial mass="0.07" ixx="0.000010725" iyy="0.000014392" izz="0.000018517"/>
      <visual>
        <geometry>
          <mesh filename="package://mycobot_description/urdf/adaptive_gripper/gripper_base.dae"/>
        </geometry>
        <origin xyz="0.0 0 -0.012" rpy="0 0 0"/>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://mycobot_description/urdf/adaptive_gripper/gripper_base.dae"/>
        </geometry>
        <origin xyz="0.0 0 -0.012" rpy="0 0 0"/>
      </collision>
    </link>

    <link name="gripper_left1">
      <xacro:simple_inertial mass="0.007" ixx="0.000001" iyy="0.000001" izz="0.000001"/>
      <visual>
        <geometry>
          <mesh filename="package://mycobot_description/urdf/adaptive_gripper/gripper_left1.dae"/>
        </geometry>
        <origin xyz="0.039 -0.0133 -0.012" rpy="0 0 0"/>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://mycobot_description/urdf/adaptive_gripper/gripper_left1.dae"/>
        </geometry>
        <origin xyz="0.039 -0.0133 -0.012" rpy="0 0 0"/>
      </collision>
    </link>

    <link name="gripper_left2">
      <xacro:simple_inertial mass="0.007" ixx="0.000001" iyy="0.000001" izz="0.000001"/>
      <visual>
        <geometry>
          <mesh filename="package://mycobot_description/urdf/adaptive_gripper/gripper_left2.dae"/>
        </geometry>
        <origin xyz="0.005 -0.0195 -0.012" rpy="0 0 0"/>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://mycobot_description/urdf/adaptive_gripper/gripper_left2.dae"/>
        </geometry>
        <origin xyz="0.005 -0.0195 -0.012" rpy="0 0 0"/>
      </collision>
    </link>

    <link name="gripper_left3">
      <xacro:simple_inertial mass="0.007" ixx="0.000001" iyy="0.000001" izz="0.000001"/>
      <visual>
        <geometry>
          <mesh filename="package://mycobot_description/urdf/adaptive_gripper/gripper_left3.dae"/>
        </geometry>
        <origin xyz="0.012 0.0025 -0.012" rpy="0 0 0"/>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://mycobot_description/urdf/adaptive_gripper/gripper_left3.dae"/>
        </geometry>
        <origin xyz="0.012 0.0025 -0.012" rpy="0 0 0"/>
      </collision>
    </link>

    <link name="gripper_right1">
      <xacro:simple_inertial mass="0.007" ixx="0.000001" iyy="0.000001" izz="0.000001"/>
      <visual>
        <geometry>
          <mesh filename="package://mycobot_description/urdf/adaptive_gripper/gripper_right1.dae"/>
        </geometry>
        <origin xyz="-0.039 -0.0133 -0.012" rpy="0 0 0"/>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://mycobot_description/urdf/adaptive_gripper/gripper_right1.dae"/>
        </geometry>
        <origin xyz="-0.039 -0.0133 -0.012" rpy="0 0 0"/>
      </collision>
    </link>

    <link name="gripper_right2">
      <xacro:simple_inertial mass="0.007" ixx="0.000001" iyy="0.000001" izz="0.000001"/>
      <visual>
        <geometry>
          <mesh filename="package://mycobot_description/urdf/adaptive_gripper/gripper_right2.dae"/>
        </geometry>
        <origin xyz="-0.005 -0.0195 -0.012" rpy="0 0 0"/>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://mycobot_description/urdf/adaptive_gripper/gripper_right2.dae"/>
        </geometry>
        <origin xyz="-0.005 -0.0195 -0.012" rpy="0 0 0"/>
      </collision>
    </link>

    <link name="gripper_right3">
      <xacro:simple_inertial mass="0.007" ixx="0.000001" iyy="0.000001" izz="0.000001"/>
      <visual>
        <geometry>
          <mesh filename="package://mycobot_description/urdf/adaptive_gripper/gripper_right3.dae"/>
        </geometry>
        <origin xyz="-0.012 0.0025 -0.012" rpy="0 0 0"/>
      </visual>
      <collision>
        <geometry>
